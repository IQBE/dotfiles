[alias]
	blame = "blame -w"
	deep-blame = "blame -C -C -C"
	lg = "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative"
	wdiff = "diff --word-diff"

[blame]
	coloring = "highlightRecent"
	date = "relative"

[branch]
	sort = "-committerdate"

[color]
	ui = "auto"

[commit]
	gpgsign = true

[core]
	autocrlf = "input"
	safecrlf = false
	whitespace = "warn,trailing-space,space-before-tab,tab-in-indent,cr-at-eol"

[fetch]
	writeCommitGraph = true

[init]
	defaultBranch = "main"

[pager]
	diff = "less"

[push]
	default = "current"
	gpgsign = "if-asked"

[rebase]
	autoStash = true
	updateRefs = true

[rerere]
	enabled = true

[signing]
	format = "gpg"
	signByDefault = true

[status]
	branch = true
	short = true
	showStash = true
	showUntrackedFiles = "all"

[tag]
	gpgsign = true
	sort = "-taggerdate"

